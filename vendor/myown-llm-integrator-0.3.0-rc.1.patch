index 0000000..6a5353e
--- /dev/null
+++ b/src/execution-policy.js
@@ -0,0 +1,127 @@
+import { isAbsolute, parse, resolve, join } from 'node:path';
+import { homedir } from 'node:os';
+import { realpath, stat } from 'node:fs/promises';
+
+export const EXECUTION_VERSION = 'codex-cli 0.163.0';
+export const PROFILE = 'dots_execution';
+const disabled = ['apps', 'plugins', 'hooks', 'multi_agent', 'multi_agent_v2', 'browser_use',
+  'computer_use', 'image_generation', 'view_image', 'shell_snapshot', 'js_repl',
+  'remote_control', 'remote_plugin', 'tool_suggest', 'auth_elicitation', 'memories',
+  'api_key_model_discovery'];
+
+export function executionScope(scope) {
+  if (scope === undefined) return undefined;
+  if (!scope || scope.access !== 'execute' || typeof scope.cwd !== 'string' ||
+      !isAbsolute(scope.cwd) || scope.cwd === parse(scope.cwd).root ||
+      Object.keys(scope).some(key => !['cwd', 'access'].includes(key))) {
+    throw new Error('An explicit project execution scope is required; filesystem root is not a project.');
+  }
+  return { cwd: scope.cwd, access: 'execute' };
+}
+
+export async function scopeIdentity(scope) {
+  if (!scope) return undefined;
+  const path = await realpath(scope.cwd);
+  const info = await stat(path);
+  if (path !== scope.cwd || !info.isDirectory()) throw new Error('Execution scope must be a canonical project directory.');
+  return `${info.dev}:${info.ino}`;
+}
+
+export function executionEnvironment(env) {
+  return Object.fromEntries(['HOME', 'PATH', 'USER', 'LOGNAME', 'LANG', 'TMPDIR', 'CODEX_HOME']
+    .filter(key => typeof env[key] === 'string').map(key => [key, env[key]]));
+}
+
+export function executionSettings(scope, env, credentialHome = resolve(env.CODEX_HOME || join(env.HOME || homedir(), '.codex'))) {
+  return {
+    model_provider: 'openai', forced_login_method: 'chatgpt', approval_policy: 'never',
+    default_permissions: PROFILE,
+    // Explicit Deny is mandatory: upstream retains the sandbox for inherited
+    // exec-policy Allow rules only when the profile has a Deny entry.
+    [`permissions.${PROFILE}.filesystem`]: { ':minimal': 'read', ...(scope ? { [scope.cwd]: 'write' } : {}), [credentialHome]: 'deny' },
+    ...(scope ? { projects: { [scope.cwd]: { trust_level: 'untrusted' } } } : {}),
+    [`permissions.${PROFILE}.network.enabled`]: false,
+    project_doc_max_bytes: 0, web_search: 'disabled', notify: [], allow_login_shell: false,
+    developer_instructions: '',
