+#!/usr/bin/env node
+import { createInterface } from 'node:readline';
+import { basename } from 'node:path';
+const mode = basename(process.argv[1]);
+if (process.argv.includes('--version')) { console.log(mode === 'wrong-version' ? 'codex-cli 0.1.0' : 'codex-cli 0.163.0'); process.exit(0); }
+const config = { mcp_servers: { inherited: { enabled: true } }, shell_environment_policy: { set: { UNAPPROVED_SECRET: 'fixture-secret' } } };
+for (let i = 0; i < process.argv.length; i++) if (process.argv[i] === '-c') {
+  const value = process.argv[++i]; const eq = value.indexOf('=');
+  const keys = value.slice(0, eq).split('.'); let target = config;
+  while (keys.length > 1) { const key = keys.shift(); target = target[key] ??= {}; }
+  const raw = value.slice(eq + 1);
+  const parsed = JSON.parse(raw.startsWith('{') ? raw.replace(/"\s*=/g, '":') : raw);
+  target[keys[0]] = parsed && !Array.isArray(parsed) && typeof parsed === 'object' ? { ...target[keys[0]], ...parsed } : parsed;
+}
+const send = m => process.stdout.write(JSON.stringify(m) + '\n');
+const reply = (m, result) => send({ id: m.id, result });
+const event = (method, params) => send({ method, params: { threadId: 'thread-1', turnId: 'turn-1', ...params } });
+const done = status => event('turn/completed', { turn: { id: 'turn-1', status, error: null } });
+function finish() { event('item/agentMessage/delta', { itemId: 'message-1', delta: 'Hello.' }); event('item/completed', { item: { type: 'agentMessage', id: 'message-1', text: 'Hello.', phase: 'final_answer' } }); done('completed'); }
+createInterface({ input: process.stdin }).on('line', line => {
+  const m = JSON.parse(line);
+  if (m.id === 900 && !m.method) { if (!m.result?.contentItems?.[0]?.text) process.exit(3); finish(); return; }
+  if (m.id === 901 && !m.method) { finish(); return; }
+  switch (m.method) {
+    case 'initialize': reply(m, { userAgent: 'fixture' }); break;
+    case 'account/read': reply(m, { account: { type: mode === 'api-auth' ? 'apiKey' : 'chatgpt' } }); break;
+    case 'configRequirements/read': reply(m, { requirements: null }); break;
+    case 'config/read': {
+      const c = structuredClone(config);
+      if (mode === 'bad-profile') c.permissions.dots_execution.filesystem['/'] = 'write';
+      if (mode === 'enabled-mcp') c.mcp_servers.inherited.enabled = true;
+      if (mode === 'bad-url') c.chatgpt_base_url = 'https://example.invalid';
+      if (mode === 'bad-provider') c.model_providers = { openai: { base_url: 'https://example.invalid' } };
+      if (mode === 'invalid-json') { process.stdout.write('bad\n'); break; }
+      if (mode === 'oversize') { process.stdout.write('x'.repeat(2 * 1024 * 1024)); break; }
+      reply(m, { config: c }); break;
+    }
+    case 'thread/start':
+      if (!m.params.permissions || !m.params.ephemeral || !Array.isArray(m.params.environments)) process.exit(4);
+      if (config.shell_environment_policy.set.UNAPPROVED_SECRET !== '') process.exit(5);
+      reply(m, { thread: { id: 'thread-1' }, activePermissionProfile: { id: 'dots_execution', extends: null } }); break;
+    case 'turn/start':
+      if (mode === 'delayed-start') { setTimeout(() => reply(m, { turn: { id: 'turn-1', status: 'inProgress' } }), 300); break; }
+      reply(m, { turn: { id: 'turn-1', status: 'inProgress' } });
+      setTimeout(() => {
+        if (mode === 'quota') { event('turn/completed', { turn: { id: 'turn-1', status: 'failed', error: { codexErrorInfo: 'usageLimitExceeded', message: 'private provider diagnostic' } } }); return; }
+        if (mode === 'crash') { event('item/started', { item: { type: 'commandExecution', id: 'command-1', command: 'touch fixture', status: 'inProgress' } }); setTimeout(() => process.exit(1), 10); }
+        else if (mode === 'tool' && config.features.code_mode_host !== true) { event('item/completed', { item: { type: 'agentMessage', id: 'message-1', text: 'Blocked: code-mode host is disabled', phase: 'final_answer' } }); done('completed'); }
+        else if (['tool', 'missing-turn'].includes(mode)) send({ id: 900, method: 'item/tool/call', params: { threadId: 'thread-1', ...(mode === 'tool' ? { turnId: 'turn-1' } : {}), callId: 'call-1', tool: 'fixture_tool', arguments: { value: 7 } } });
+        else if (mode === 'foreign') send({ id: 901, method: 'item/tool/call', params: { threadId: 'foreign', turnId: 'turn-1', callId: 'call-1', tool: 'fixture_tool', arguments: {} } });
+        else if (mode !== 'wait') finish();
+      }, 10); break;
+    case 'turn/interrupt': reply(m, {}); if (mode !== 'delayed-start') done('interrupted'); break;
+    case 'thread/unsubscribe': reply(m, {}); break;
+  }
+});
