+  async function close() {
+    if (closing) return closing;
+    closed = true;
+    closing = (async () => { await interrupt(); await startup?.catch(() => {}); await stop(runtime); if (scratch) await rm(scratch, { recursive: true, force: true }); })();
+    return closing;
+  }
+  return { warm, run, interrupt, close };
+}
