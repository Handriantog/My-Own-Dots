@@ -0,0 +1,54 @@
+// Run: node native-mcp-probe.mjs /absolute/integrator/root /absolute/codex [--control]
+// Fresh HOME/CODEX_HOME; no login, account read, turn/start, or inference.
+import assert from 'node:assert/strict';
+import { spawn, execFileSync } from 'node:child_process';
+import { mkdtemp, mkdir, writeFile, readFile, rm, realpath } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { createInterface } from 'node:readline';
+const [integrator, executable] = process.argv.slice(2);
+const control = process.argv.includes('--control');
+const { executionSettings, executionArguments, verifyExecutionConfig, EXECUTION_VERSION } = await import(pathToFileURL(join(integrator, 'src/execution-policy.js')));
+const root = await realpath(await mkdtemp(join(tmpdir(), 'mcp-boundary-probe-')));
+const project = join(root, 'project'), home = join(root, 'home'), credentialHome = join(home, '.codex');
+await mkdir(join(project, '.codex'), { recursive: true }); await mkdir(credentialHome, { recursive: true });
+await writeFile(join(credentialHome,'config.toml'), '[projects."/unrelated-review-fixture"]\ntrust_level = "trusted"\n');
+const marker = join(root, 'outside-mcp-marker');
+await writeFile(join(project, '.codex/config.toml'), `[mcp_servers.review_marker]\ncommand = "/bin/sh"\nargs = ["-c", "printf started > ${marker}"]\n`);
+const env = { HOME: home, CODEX_HOME: credentialHome, PATH: process.env.PATH };
+assert.equal(execFileSync(executable, ['--version'], { env, encoding: 'utf8' }).trim(), EXECUTION_VERSION);
+const settings = executionSettings({ cwd: project, access: 'execute' }, env, credentialHome);
+if (control) delete settings.projects; // Deliberately reproduce the old trust-transition bug.
+const child = spawn(executable, executionArguments(settings), { cwd: project, env, stdio: ['pipe', 'pipe', 'pipe'], detached: true });
+child.stderr.resume(); const pending = new Map(); let id = 0;
+const send = m => child.stdin.write(JSON.stringify(m) + '\n');
+const rpc = (method, params) => new Promise((resolve, reject) => {
+  const n = ++id, timer = setTimeout(() => reject(Error(`RPC timeout: ${method}`)), 15000);
+  pending.set(n, { resolve, reject, timer }); send({ id: n, method, params });
+});
+createInterface({ input: child.stdout }).on('line', line => {
+  const m = JSON.parse(line), p = pending.get(m.id);
+  if (p && !m.method) { pending.delete(m.id); clearTimeout(p.timer); m.error ? p.reject(Error(`RPC rejected: ${m.error.code}`)) : p.resolve(m.result); }
+  else if (m.id !== undefined && m.method) send({ id: m.id, error: { code: -32000, message: 'Not approved' } });
+});
+try {
+  await rpc('initialize', { clientInfo: { name: 'native_boundary_review', version: '0.1.0' }, capabilities: { experimentalApi: true } });
+  send({ method: 'initialized', params: {} });
+  const before = await rpc('config/read', { includeLayers: true, cwd: project });
+  verifyExecutionConfig(before, settings);
+  assert.equal(Object.keys(before.config.mcp_servers ?? {}).length, 0);
+  await rpc('thread/start', { cwd: project, permissions: 'dots_execution', approvalPolicy: 'never', modelProvider: 'openai', ephemeral: true,
+    runtimeWorkspaceRoots: [project], selectedCapabilityRoots: [], baseInstructions: 'Startup-only boundary test. No inference.' });
+  await new Promise(resolve => setTimeout(resolve, 100));
+  const after = await rpc('config/read', { includeLayers: true, cwd: project });
+  const started = await readFile(marker, 'utf8').then(text => text === 'started', () => false);
+  if (!control) { verifyExecutionConfig(after, settings); assert.equal(started, false); assert.equal(Object.keys(after.config.mcp_servers ?? {}).length, 0); }
+  else assert.equal(started, true, 'Control must demonstrate that the fixture was capable of starting.');
+  console.log(JSON.stringify({ mode: control ? 'vulnerable-control' : 'hardened', unapprovedHostProcessStarted: started, passed: true }));
+} finally {
+  for (const p of pending.values()) clearTimeout(p.timer);
+  child.stdin.end(); try { process.kill(-child.pid, 'SIGTERM'); } catch {}
+  await new Promise(resolve => setTimeout(resolve, 400)); try { process.kill(-child.pid, 'SIGKILL'); } catch {}
+  await rm(root, { recursive: true, force: true });
+}
