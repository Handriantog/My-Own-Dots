+// Explicit live qualification: disposable files; consumes existing ChatGPT allowance.
+import assert from 'node:assert/strict';
+import { mkdtemp, realpath, mkdir, writeFile, readFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createExecutionSession } from '../src/index.js';
+if (!process.argv.includes('--live')) throw new Error('Pass --live to authorize a real subscription model request.');
+const root = await realpath(await mkdtemp(join(tmpdir(), 'dots-execution-qualification-')));
+const project = join(root, 'project'); await mkdir(project);
+await writeFile(join(project, 'math.cjs'), 'exports.add=(a,b)=>a-b;\n');
+await writeFile(join(project, 'test.cjs'), "require('node:assert/strict').equal(require('./math.cjs').add(2,3),5);console.log('TEST_PASSED');\n");
+await writeFile(join(root, 'outside.txt'), 'OUTSIDE_UNCHANGED');
+let toolCalls = 0;
+const session = createExecutionSession({ scope: { cwd: project, access: 'execute' }, timeoutMs: 180_000,
+  tools: [{ name: 'fixture_value', description: 'Read fixture value', inputSchema: { type: 'object', properties: {}, additionalProperties: false } }],
+  onTool: async () => { toolCalls++; return { content: '7' }; } });
+const started = performance.now();
+try {
+  const result = await session.run({ input: `Call fixture_value. Reproduce the failure using ${process.execPath} test.cjs, fix math.cjs, then run the test again. Stay inside this disposable project. Report observed results.`,
+    onEvent: event => { if (event.type !== 'text') console.log(JSON.stringify(event)); } });
+  console.log(JSON.stringify({ status: result.status, elapsedMs: performance.now() - started, toolCalls, source: await readFile(join(project, 'math.cjs'), 'utf8') }));
+  assert.equal(result.status, 'completed');
+  assert.equal(toolCalls, 1);
+  assert.ok(result.evidence.some(e => e.kind === 'command' && e.exitCode === 0 && /^TEST_PASSED$/m.test(e.output ?? '')), 'A real passing test is required; assistant claims and source listings are insufficient.');
+  assert.equal(await readFile(join(project, 'test.cjs'), 'utf8'), "require('node:assert/strict').equal(require('./math.cjs').add(2,3),5);console.log('TEST_PASSED');\n");
+  assert.ok(result.evidence.some(e => e.kind === 'command' && e.exitCode !== null && e.exitCode !== 0), 'The initial failure must be reproduced.');
+  assert.equal(await readFile(join(root, 'outside.txt'), 'utf8'), 'OUTSIDE_UNCHANGED');
+} finally { await session.close(); await rm(root, { recursive: true, force: true }); }
