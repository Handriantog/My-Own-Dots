+// Native model-output/execpolicy probe. No login or owner configuration is used.
+// Run: node native-rule-probe.mjs /absolute/integrator/root /absolute/codex [--control]
+// A loopback Responses fixture emits one code-mode call. Production Integrator
+// intentionally rejects this provider; this harness qualifies the pinned engine.
+import assert from 'node:assert/strict';
+import { spawn, execFileSync } from 'node:child_process';
+import { createServer } from 'node:http';
+import { mkdtemp, mkdir, writeFile, rm, realpath } from 'node:fs/promises';
+import { tmpdir } from 'node:os'; import { join } from 'node:path';
+import { pathToFileURL } from 'node:url'; import { createInterface } from 'node:readline';
+const [integrator, executable] = process.argv.slice(2), control = process.argv.includes('--control');
+const { executionSettings, executionArguments, EXECUTION_VERSION } = await import(pathToFileURL(join(integrator,'src/execution-policy.js')));
+const root = await realpath(await mkdtemp(join(tmpdir(),'rule-boundary-probe-')));
+const project=join(root,'project'), home=join(root,'home'), credentialHome=join(home,'.codex'), outside=join(root,'outside.txt');
+await mkdir(project); await mkdir(join(credentialHome,'rules'),{recursive:true});
+const marker='OUTSIDE_READ_MARKER_REVIEW'; await writeFile(outside,marker); await writeFile(join(project,'inside.txt'),'INSIDE_READ_MARKER_REVIEW');
+await writeFile(join(credentialHome,'rules','review.rules'),'prefix_rule(pattern=["/bin/cat"], decision="allow")\n');
+const env={HOME:home,CODEX_HOME:credentialHome,PATH:process.env.PATH};
+assert.equal(execFileSync(executable,['--version'],{env,encoding:'utf8'}).trim(),EXECUTION_VERSION);
+let modelRequests=0, observedOutsideRead=false; const commandEvents=[], toolResults=[];
+const server=createServer(async (req,res)=>{
+  let body=''; for await(const chunk of req) body+=chunk;
+  if(req.method!=='POST'||!req.url.endsWith('/responses')) {res.writeHead(404);res.end();return;}
+  modelRequests++; if(body.includes(marker)) observedOutsideRead=true; if(modelRequests>1){for(const item of JSON.parse(body).input??[]){if(item.type!=='custom_tool_call_output')continue;for(const content of Array.isArray(item.output)?item.output:[]){try{const result=JSON.parse(content.text);if(typeof result.exit_code==='number')toolResults.push(result);}catch{}}}}
+  const id=`response-${modelRequests}`;
+  const tool={type:'response.output_item.done',item:{type:'custom_tool_call',name:'exec',call_id:'review-call',input:`for (const cmd of ${JSON.stringify([`/bin/cat ${JSON.stringify(join(project,'inside.txt'))}`,`/bin/cat ${JSON.stringify(outside)}`])}) text(JSON.stringify(await tools.exec_command({cmd,yield_time_ms:1000})));`}};
+  const message={type:'response.output_item.done',item:{type:'message',role:'assistant',id:'message-final',content:[{type:'output_text',text:'Fixture finished.'}]}};
+  const events=[{type:'response.created',response:{id}},modelRequests===1?tool:message,{type:'response.completed',response:{id,usage:{input_tokens:0,output_tokens:0,total_tokens:0}}}];
+  res.writeHead(200,{'content-type':'text/event-stream'});res.end(events.map(e=>`data: ${JSON.stringify(e)}\n\n`).join(''));
+});
+await new Promise(resolve=>server.listen(0,'127.0.0.1',resolve));
+const settings=executionSettings({cwd:project,access:'execute'},env,credentialHome);
+if(control) delete settings['permissions.dots_execution.filesystem'][credentialHome];
+settings.model_provider='boundary_fixture'; settings['model_providers.boundary_fixture']={name:'Boundary fixture',base_url:`http://127.0.0.1:${server.address().port}/v1`,wire_api:'responses',requires_openai_auth:false,supports_websockets:false};
+const child=spawn(executable,executionArguments(settings),{cwd:project,env,stdio:['pipe','pipe','pipe'],detached:true});
+child.stderr.resume();let id=0;const pending=new Map();const send=m=>child.stdin.write(JSON.stringify(m)+'\n');
+const rpc=(method,params)=>new Promise((resolve,reject)=>{const n=++id,timer=setTimeout(()=>reject(Error(`RPC timeout ${method}`)),15000);pending.set(n,{resolve,reject,timer});send({id:n,method,params});});
+let finish;const completion=new Promise(resolve=>finish=resolve);const timeout=setTimeout(()=>finish({status:'timeout'}),30000);
+createInterface({input:child.stdout}).on('line',line=>{const m=JSON.parse(line),p=pending.get(m.id);if(p&&!m.method){pending.delete(m.id);clearTimeout(p.timer);m.error?p.reject(Error(`RPC rejected ${m.error.code}`)):p.resolve(m.result);}else if(m.id!==undefined&&m.method)send({id:m.id,error:{code:-32000,message:'Not approved'}});if(m.method==='item/completed'&&m.params.item.type==='commandExecution')commandEvents.push(m.params.item);if(m.method==='turn/completed')finish(m.params.turn);});
+try {
+  await rpc('initialize',{clientInfo:{name:'native_rule_boundary_review',version:'0.1.0'},capabilities:{experimentalApi:true}});send({method:'initialized',params:{}});
+  const thread=await rpc('thread/start',{cwd:project,permissions:'dots_execution',approvalPolicy:'never',modelProvider:'boundary_fixture',model:'gpt-5.2',ephemeral:true,runtimeWorkspaceRoots:[project],selectedCapabilityRoots:[],baseInstructions:'Run the supplied fixture tool call.'});
+  await rpc('turn/start',{threadId:thread.thread.id,input:[{type:'text',text:'Run the boundary fixture.',text_elements:[]}]});
+  const turn=await completion;
+  console.log(JSON.stringify({mode:control?'vulnerable-control':'hardened',status:turn.status,modelRequests,commandCount:commandEvents.length,exitCodes:toolResults.map(e=>e.exit_code),observedOutsideRead,deniedBySandbox:toolResults[1]?.output?.includes('Operation not permitted')??false}));
+  assert.equal(turn.status,'completed');assert.equal(toolResults.length,2);assert.equal(toolResults[0].exit_code,0);assert.match(toolResults[0].output,/INSIDE_READ_MARKER_REVIEW/);assert.equal(observedOutsideRead,control);
+  assert.equal(toolResults[1].exit_code===0,control);if(!control)assert.match(toolResults[1].output,/Operation not permitted/);
