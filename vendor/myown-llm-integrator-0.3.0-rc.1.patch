+++ b/tests/execution-session.test.mjs
@@ -0,0 +1,139 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, symlink, rm, chmod, readFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import * as api from '../src/index.js';
+
+const fixture = fileURLToPath(new URL('./fixtures/execution-server.mjs', import.meta.url));
+async function session(t, mode = 'normal', options = {}, configured = false) {
+  const dir = await mkdtemp(join(tmpdir(), 'execution-test-'));
+  const executable = join(dir, mode);
+  await chmod(fixture, 0o755);
+  await symlink(fixture, executable);
+  const s = api.createExecutionSession({ ...(configured ? { env: { ...process.env, CODEX_BIN: executable } } : { executable }), timeoutMs: 3000, ...options });
+  t.after(async () => { await s.close(); await rm(dir, { recursive: true, force: true }); });
+  return s;
+}
+
+test('execution is additive and never enables native tools without an execution scope', async t => {
+  assert.equal(typeof api.createExecutionSession, 'function');
+  const s = await session(t);
+  const events = [];
+  const result = await s.run({ input: 'hello', onEvent: event => events.push(event) });
+  assert.equal(result.status, 'completed');
+  assert.equal(result.text, 'Hello.');
+  assert.ok(events.some(e => e.type === 'text' && e.text === 'Hello.'));
+  assert.equal(result.evidence.length, 0);
+});
+
+test('honors the host-configured Codex executable instead of silently using PATH', async t => {
+  const s = await session(t, 'wrong-version', {}, true);
+  await assert.rejects(s.warm(), /Unsupported Codex version/);
+});
+
+test('host tool calls are correlated and their results returned exactly once', async t => {
+  let count = 0;
+  const s = await session(t, 'tool', { tools: [{ name: 'fixture_tool', description: 'fixture', inputSchema: { type: 'object' } }], onTool: async call => { count++; assert.equal(call.arguments.value, 7); return { content: 'observed 7' }; } });
+  const result = await s.run({ input: 'use tool' });
+  assert.equal(result.status, 'completed');
+  assert.equal(count, 1);
+  assert.equal(result.evidence[0].kind, 'tool');
+  assert.equal(result.evidence[0].status, 'completed');
+});
+
+for (const [mode, expected] of [
+  ['wrong-version', /0\.163\.0/], ['api-auth', /ChatGPT/],
+  ['bad-profile', /permission|configuration/i], ['enabled-mcp', /MCP/],
+  ['bad-url', /URL|endpoint/i], ['bad-provider', /endpoint|provider/i], ['invalid-json', /protocol/i],
+  ['oversize', /limit/i],
+]) test(`blocks ${mode} before executing a task`, async t => {
+  const s = await session(t, mode);
+  await assert.rejects(s.run({ input: 'do work' }), expected);
+});
+
+test('process loss after command dispatch is uncertain and cannot replay on the same session', async t => {
+  const s = await session(t, 'crash');
+  const result = await s.run({ input: 'mutate' });
+  assert.equal(result.status, 'uncertain');
+  assert.equal(result.evidence[0].kind, 'command');
+  await assert.rejects(s.run({ input: 'mutate again' }), /closed|unavailable/i);
+});
+
+test('cancellation stops an active turn and rejects concurrent dispatch', async t => {
+  const s = await session(t, 'wait');
+  await s.warm();
+  const controller = new AbortController();
+  const result = s.run({ input: 'wait', signal: controller.signal });
+  await assert.rejects(s.run({ input: 'overlap' }), /active|running/i);
+  setTimeout(() => controller.abort(), 100);
+  assert.equal((await result).status, 'cancelled');
+});
+
+test('cancellation before a dispatched turn acknowledgement still requires a confirmed stop', async t => {
+  const s = await session(t, 'delayed-start');
+  await s.warm();
+  const controller = new AbortController();
+  const result = s.run({ input: 'work', signal: controller.signal });
+  setTimeout(() => controller.abort(), 100);
+  assert.equal((await result).status, 'uncertain');
+});
+
+test('cancellation during an awaited event callback prevents the host effect', async t => {
+  let effects = 0;
+  const s = await session(t, 'tool', { tools: [{ name: 'fixture_tool', description: 'fixture', inputSchema: { type: 'object' } }], onTool: async () => { effects++; return { content: 'done' }; } });
+  const controller = new AbortController();
+  await s.run({ input: 'work', signal: controller.signal, onEvent: async event => {
+    if (event.type === 'tool') { controller.abort(); await new Promise(resolve => setTimeout(resolve, 50)); }
+  } });
+  assert.equal(effects, 0);
+});
+
+test('a tool call without a matching turn identity cannot invoke the host', async t => {
+  let effects = 0;
+  const s = await session(t, 'missing-turn', { tools: [{ name: 'fixture_tool', description: 'fixture', inputSchema: { type: 'object' } }], onTool: async () => { effects++; return { content: 'done' }; } });
+  assert.equal((await s.run({ input: 'work' })).status, 'uncertain');
+  assert.equal(effects, 0);
+});
+
+test('timeouts never retry potentially dispatched work', async t => {
+  const s = await session(t, 'wait');
+  const result = await s.run({ input: 'wait', timeoutMs: 100 });
+  assert.equal(result.status, 'uncertain');
+});
+
+test('reports a subscription limit precisely without leaking provider diagnostic text or falling back', async t => {
+  const s = await session(t, 'quota');
+  const result = await s.run({ input: 'hello' });
+  assert.equal(result.status, 'failed');
+  assert.match(result.error, /subscription.*limit/i);
+  assert.doesNotMatch(result.error, /private provider/);
+});
+
+test('cancellation of a hung host callback stays uncertain and bounded', async t => {
+  let entered;
+  const ready = new Promise(resolve => { entered = resolve; });
+  const s = await session(t, 'tool', { tools: [{ name: 'fixture_tool', description: 'fixture', inputSchema: { type: 'object' } }], onTool: async () => { entered(); return new Promise(() => {}); } });
+  const controller = new AbortController();
+  const pending = s.run({ input: 'work', signal: controller.signal });
+  await ready; controller.abort();
+  assert.equal((await pending).status, 'uncertain');
+});
+
+test('foreign and late tool requests cannot invoke host capabilities', async t => {
+  let count = 0;
+  const s = await session(t, 'foreign', { tools: [{ name: 'fixture_tool', description: 'fixture', inputSchema: { type: 'object' } }], onTool: async () => { count++; return { content: 'no' }; } });
+  assert.equal((await s.run({ input: 'go' })).status, 'completed');
+  assert.equal(count, 0);
+});
+
+test('a host permission request pauses the turn without claiming completion', async t => {
+  const s = await session(t, 'tool', { tools: [{ name: 'fixture_tool', description: 'fixture', inputSchema: { type: 'object' } }], onTool: async () => ({ content: 'approval required', pause: true }) });
+  assert.equal((await s.run({ input: 'request' })).status, 'paused');
+});
+
+test('native project execution requires a canonical directory and explicit run authorization', async () => {
+  assert.throws(() => api.createExecutionSession({ scope: { cwd: '/tmp', access: 'readwrite' } }), /execution|execute|scope/i);
+  assert.throws(() => api.createExecutionSession({ scope: { cwd: '/', access: 'execute' } }), /root|scope/i);
+});
