# My Own Dots: subscription inference and local conversation storage.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the persistent conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

# Local conversation backend: PostgreSQL in Docker, app and AI CLI on this host.
# Run npm run setup:local to generate credentials, then npm run conversations:up.
CONVERSATION_BACKEND=local
LOCAL_POSTGRES_PASSWORD=
LOCAL_POSTGRES_PORT=5434
LOCAL_DATABASE_URL=

# Your authenticated subscription CLI, through myown-llm-integrator.
# npm run setup:llm installs the Python engine. Log in to your CLI separately.
LLM_BACKEND=subscription
LLM_PROVIDER=codex
# Optional override; unset inherits CODEX_MODEL/AGENT_MODEL or the CLI default.
LLM_MODEL=
# Includes CLI queue wait and all tool steps in a turn (milliseconds).
AGENT_RUN_TIMEOUT_MS=900000
# Local context limits; conservative UTF-8-byte estimates, not provider usage.
MEMORY_INPUT_TOKEN_LIMIT=24000
MEMORY_PINNED_TOKEN_LIMIT=2000
# Learning, automatic Compact/Dream, timing and policy are saved per Dot in the UI.
# CODEX_BIN=/absolute/path/to/codex
# AGENT_BIN=/absolute/path/to/other-cli
# MYOWN_LLM_PYTHON=/absolute/path/to/venv/bin/python

# Local mode opts out of CopilotKit telemetry by default.
DO_NOT_TRACK=1
COPILOTKIT_TELEMETRY_DISABLED=true

# Optional legacy model backend: set LLM_BACKEND=openai explicitly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional licensed/hosted conversations: CONVERSATION_BACKEND=intelligence.
# Required only for managed Slack, Automatic Learning or existing hosted threads.
INTELLIGENCE_API_KEY=
# CPK_INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# INTELLIGENCE_GATEWAY_WS_URL=
# INTELLIGENCE_WS_URL=
# CPK_TELEMETRY_ID=

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional connected apps through Composio; see docs/SETUP.md#composio.
COMPOSIO_API_KEY=

# Optional realtime speech; compute uses the same saved conversation.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional managed Slack channel; see docs/SETUP.md#slack.
# Match the managed declaration name, not a Slack #conversation name.
# OpenTag calls this INTELLIGENCE_CHANNEL_NAME; OpenDots uses SLACK_CHANNEL_NAME.
# Allowlist both the Slack workspace and explicit Slack user IDs.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Public-web provider: disabled (default), browser (URL-only), or parallel.
# Selecting parallel sends queries and selected URLs to that service.
WEB_SEARCH_PROVIDER=disabled
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=

# Optional local desktop voice. Install the pinned speech runtime/models first.
# Speech is local; reasoning still uses the selected AI subscription.
LOCAL_VOICE_ENABLED=0
# LOCAL_VOICE_PYTHON=/absolute/path/to/voice-venv/bin/python
# LOCAL_VOICE_ASSETS=/absolute/path/to/voice-assets
# High is opt-in: Apple Silicon macOS, SQLite workspace, separate pinned runtime.
# LOCAL_VOICE_NATIVE_ROOT=/absolute/path/to/native-voice
# LOCAL_VOICE_NATIVE_PYTHON=/absolute/path/to/native-voice/venv/bin/python

# Optional interpreter override for approved local-folder operations (Python 3.11+).
# DOTS_FOLDER_PYTHON=/absolute/path/to/python3

# Reuse the installed Integrator's Python runtime during local voice calls.
# Typed chat still uses runAgent. Set 0 to compare the previous voice path.
LOCAL_VOICE_INTEGRATOR_SESSION=0

# Reuse the Codex provider process and stream validated, saved voice sentences.
# Requires reviewed Codex 0.157.1 and ChatGPT sign-in; no paid audio API.
# Takes precedence over LOCAL_VOICE_INTEGRATOR_SESSION for Codex calls only.
LOCAL_VOICE_PROVIDER_SESSION=0
# Content-free, per-turn phase timings in server stdout; inspect with npm run voice:timings.
LOCAL_VOICE_TIMING_LOG=0
